    "minimum-stability": "alpha",
    "prefer-stable": true,
    "autoload-dev": {
        "psr-4": {
            "Drupal\\Tests\\openculturas\\": "tests/src"
        }
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "drupal/core-composer-scaffold": true,
            "drupal/core-vendor-hardening": true,
            "ergebnis/composer-normalize": true,
            "oomphinc/composer-installers-extender": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true,
            "tbachert/spi": true
        },
        "platform": {
            "php": "8.1.16"
        },
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "composer-exit-on-patch-failure": true,
        "drupal-core-vendor-hardening": {
            "drupal/core": [
                "install.php",
                "authorize.php",
                "rebuild.php"
            ]
        },
        "drupal-scaffold": {
            "file-mapping": {
                "[project-root]/.gitattributes": false,
                "[web-root]/.csslintrc": false,
                "[web-root]/.ht.router.php": false,
                "[web-root]/INSTALL.txt": false,
                "[web-root]/README.md": false,
                "[web-root]/example.gitignore": false,
                "[web-root]/modules/README.txt": false,
                "[web-root]/profiles/README.txt": false,
                "[web-root]/sites/README.txt": false,
                "[web-root]/sites/development.services.yml": {
                    "mode": "replace",
                    "overwrite": false,
                    "path": "assets/development.services.yml"
                },
                "[web-root]/sites/example.sites.php": false,
                "[web-root]/themes/README.txt": false,
                "[web-root]/update.php": false,
                "[web-root]/web.config": false
            },
            "locations": {
                "web-root": "web/"
            }
        },
        "enable-patching": true,
        "installer-paths": {
            "web/core": [
                "type:drupal-core"
            ],
            "web/libraries/{$name}": [
                "type:drupal-library"
            ],
            "web/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "web/profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "web/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "drush/Commands/contrib/{$name}": [
                "type:drupal-drush"
            ],
            "web/modules/custom/{$name}": [
                "type:drupal-custom-module"
            ],
            "web/profiles/custom/{$name}": [
                "type:drupal-custom-profile"
            ],
            "web/themes/custom/{$name}": [
                "type:drupal-custom-theme"
            ]
        },
        "patchLevel": {
            "drupal/core": "-p2"
        },
        "patches": {
            "drupal/address_display": {
                "https://www.drupal.org/project/address_display/issues/3492898: Verify that the label for address_line3 is available": "https://www.drupal.org/files/issues/2024-12-10/address_display_3492898-addressLine3.patch"
            },
            "drupal/asset_injector": {
                "Issue #3082195: Support loading ACE editor locally w/o CDN": "https://www.drupal.org/files/issues/2025-09-23/asset_injector-3082195.8.x-2.21.patch"
            },
            "drupal/block_field": {
                "Issue #3165388: Field Widget broke in translation node": "https://www.drupal.org/files/issues/2023-06-07/block_field-3165388-10.patch"
            },
            "drupal/core": {
                "Issue #3221375: Wrong language field labels after drupal_rebuild()": "https://www.drupal.org/files/issues/2021-12-01/3221375-27-workaround.patch",
                "Issue #2845144: User can't reference unpublished content even when they have access to it": "https://www.drupal.org/files/issues/2024-02-13/2845144-87.patch",
                "Issue #2321071: BaseFieldOverride fails to take into account ContentEntityInterface::bundleFieldDefinitions() when invoking onFieldDefinitionUpdate()": "https://www.drupal.org/files/issues/2023-11-02/2321071-71.patch",
                "Issue #3377166: WorkflowDeleteForm should extend EntityDeleteForm": "https://www.drupal.org/files/issues/2023-09-12/3377166-10.patch",
                "Issue #2546212: Entity view/form mode formatter/widget settings have no translation": "https://www.drupal.org/files/issues/2024-04-08/drupal-core-2546212-10.3.x.patch",
                "Issue #3466040: Dialog button/inputs not visible when open details element": "https://www.drupal.org/files/issues/2024-08-05/drupal-core-3466040-10.3.x.patch",
                "Issue #1707926: Allow to add spacing to prefix and suffix on numeric fields": "https://www.drupal.org/files/issues/2022-08-18/1707926-spacing-field-prefixes-30.patch"
            },
            "drupal/core_needs_rebuild": {
                "Issue #2818017: A number of Views combined fields filter operators are currently pointless to an end user": "https://www.drupal.org/files/issues/2023-02-07/2818017-30.patch"
            },
            "drupal/ctools": {
                "https://www.drupal.org/project/ctools/issues/2992362: Wizards should be using PrivateTempStore": "https://www.drupal.org/files/issues/2022-11-17/ctools-wizard_should_use_privatetempstore_instead-2992362-32.patch"
            },
            "drupal/entity_reference_revisions": {
                "Issue #2799479: Views doesn't recognize relationship to host": "https://www.drupal.org/files/issues/2023-06-29/entity_reference_revisions-2799479-fix-only.patch"
            },
            "drupal/facets": {
                "https://www.drupal.org/project/facets/issues/3466281: Creating requests causes failures on Drupal 10.3": "https://www.drupal.org/files/issues/2024-11-21/3466281-7.patch"
            },
            "drupal/field_permissions": {
                "Issue #3342508: RuntimeException: Adding non-existent permissions to a role is not allowed.": "https://www.drupal.org/files/issues/2023-11-09/field_permissions-3342508.patch"
            },
            "drupal/flag": {
                "Issue #3143606: missing global value when saving flagging with form field entry": "https://www.drupal.org/files/issues/2020-05-28/flagging_global-3143606-3.patch"
            },
            "drupal/formtips": {
                "Issue #3292882: Filter tips are hardly readable in GIN": "https://git.drupalcode.org/project/formtips/-/merge_requests/3.diff"
            },
            "drupal/ief_complex_open": {
                "Issue #3440010: Missing config schema": "https://git.drupalcode.org/project/ief_complex_open/-/merge_requests/6.diff"
            },
            "drupal/image_widget_crop": {
                "Issue #3093928: The Cropper library used is deprecated": "https://www.drupal.org/files/issues/2023-02-17/3093928-17.patch"
            },
            "drupal/media_entity_download": {
                "Issue #3308048: Use label as link text": "https://git.drupalcode.org/project/media_entity_download/-/merge_requests/6.diff"
            },
            "drupal/node_edit_protection": {
                "Issue #3455823: Fix the warning issue that occurs when pressing the save submit button in the Gin Admin theme": "https://www.drupal.org/files/issues/2024-08-05/node-edit-protection-3455823-fix-the-warning-22.patch"
            },
            "drupal/office_hours": {
                "https://www.drupal.org/project/office_hours/issues/3135259: Replace operation links in the widget with a dropbutton": "https://www.drupal.org/files/issues/2025-02-11/office_hours-8.x-1.21-3135259-replace-operation-links.patch"
            },
            "drupal/paragraphs": {
                "Issue #3350698: make behaviours translatable": "https://www.drupal.org/files/issues/2023-03-28/3350698--3.patch"
            },
            "drupal/simple_image_rotate": {
                "https://www.drupal.org/project/simple_image_rotate/issues/3317110: simple_image_rotate_rotate_image isn't idempotent": "https://www.drupal.org/files/issues/2022-10-23/simple_image_rotate_idempotent.patch",
                "https://www.drupal.org/project/simple_image_rotate/issues/3476687: Replace link with button": "https://www.drupal.org/files/issues/2024-09-26/simple_image_rotate-3476687-replace-link-with-button.patch"
            },
            "drupal/smart_date": {
                "Issue #3446002: Restore origin starts/ends filter": "https://www.drupal.org/files/issues/2024-06-18/smart_date-3446002.patch"
            },
            "drupal/views_infinite_scroll": {
                "Issue #3267139: Make Load more markup more accessible": "https://www.drupal.org/files/issues/2022-07-18/views_infinite_scroll-3267139-missing-pager-headline-10.patch"
            }
        }
    },
    "scripts": {
        "cde": [
            "drush pm:install config_devel --yes",
            "drush cde openculturas",
            "drush cde openculturas_faq",
            "drush cde openculturas_discussions",
            "drush cde openculturas_map",
            "drush cde openculturas_section",
            "drush cde openculturas_openstreetmap"
        ],
        "export-content": [
            "drush pm:install default_content --yes",
            "rm -rf web/profiles/contrib/openculturas-profile/modules/custom/openculturas_content/content",
            "drush default-content:export-references node --folder=profiles/contrib/openculturas-profile/modules/custom/openculturas_content/content",
            "drush default-content:export-references media --folder=profiles/contrib/openculturas-profile/modules/custom/openculturas_content/content",
            "drush default-content:export-references menu_link_content --folder=profiles/contrib/openculturas-profile/modules/custom/openculturas_content/content",
            "drush default-content:export-references taxonomy_term --folder=profiles/contrib/openculturas-profile/modules/custom/openculturas_content/content",
            "drush pm:uninstall default_content --yes"
        ],
        "info_file_normalizer": "@php scripts/info_file_normalizer.php",
        "php:cs": "phpcs -s",
        "php:cs-fix": "phpcbf",
        "php:lint": [
            "parallel-lint --colors --show-deprecated -e php,module,install,profile,theme profile"
        ],
        "php:phpstan": "phpstan",
        "php:qa": [
            "@php:lint",
            "@php:cs",
            "@php:phpstan",
            "@php:rector"
        ],
        "php:rector": "rector process --dry-run",
        "php:rector-fix": "rector process",
        "si": [
            "rm -rf web/sites/default/files && mkdir -p web/sites/default/files/translations",
            "drush site:install --yes"
        ]
    }
}
