                    "type": "zip",
                    "url": "https://github.com/heiseonline/shariff/releases/download/3.2.1/shariff-3.2.1.zip"
                }
            }
        },
        {
            "type": "package",
            "package": {
                "name": "ajaxorg/ace-builds",
                "type": "drupal-library",
                "version": "1.43.4",
                "extra": {
                    "installer-name": "ace-builds"
                },
