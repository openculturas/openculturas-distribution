<?php

/**
 * @file
 * Install, update and uninstall functions for the openculturas_faq module.
 */

declare(strict_types=1);

use Drupal\Core\Field\FieldConfigInterface;
use Drupal\field\Entity\FieldConfig;
use Drupal\user\Entity\Role;
use Drupal\user\RoleInterface;
use Drupal\views\Entity\View;
use Drupal\views\ViewEntityInterface;

/**
 * Implements hook_install().
 */
function openculturas_faq_install(bool $is_syncing): void {
  if ($is_syncing) {
    return;
  }

  /** @var \Drupal\user\RoleInterface|null $role */
  $role = Role::load('oc_admin');
  if ($role instanceof RoleInterface) {
    $role->grantPermission('create faq content');
    $role->grantPermission('create terms in faq_category');
    $role->grantPermission('delete any faq content');
    $role->grantPermission('delete faq revisions');
    $role->grantPermission('delete own faq content');
    $role->grantPermission('delete terms in faq_category');
    $role->grantPermission('edit any faq content');
    $role->grantPermission('edit own faq content');
    $role->grantPermission('edit terms in faq_category');
    $role->grantPermission('revert faq revisions');
    $role->grantPermission('translate faq node');
    $role->grantPermission('translate faq_category taxonomy_term');
    $role->grantPermission('view faq revisions');
    $role->save();
  }

  /** @var \Drupal\Core\Field\FieldConfigInterface|null $field */
  $field = FieldConfig::loadByName('paragraph', 'view', 'field_view');
  if ($field instanceof FieldConfigInterface) {
    $allowed_views_setting = is_array($field->getSetting('allowed_views')) ? $field->getSetting('allowed_views') : [];
    $allowed_views_setting['faq'] = 'faq';
    $field->setSetting('allowed_views', $allowed_views_setting);
    $field->save();
  }

  openculturas_faq_set_term_reference_allowed(TRUE);
}

/**
 * Implements hook_uninstall().
 *
 * Runs before the faq_category vocabulary is deleted. Otherwise the view
 * depending on it would be deleted along with it.
 */
function openculturas_faq_uninstall(bool $is_syncing): void {
  if ($is_syncing) {
    return;
  }

  openculturas_faq_set_term_reference_allowed(FALSE);
}

/**
 * Allows or disallows referencing faq_category terms in teasers to terms.
 *
 * @see views.view.entity_reference_term
 */
function openculturas_faq_set_term_reference_allowed(bool $allowed): void {
  $view = View::load('entity_reference_term');
  if (!$view instanceof ViewEntityInterface) {
    return;
  }

  $display = &$view->getDisplay('default');
  if (!isset($display['display_options']['filters']['vid']['value']) || !is_array($display['display_options']['filters']['vid']['value'])) {
    return;
  }

  if ($allowed) {
    $display['display_options']['filters']['vid']['value']['faq_category'] = 'faq_category';
    ksort($display['display_options']['filters']['vid']['value']);
  }
  else {
    unset($display['display_options']['filters']['vid']['value']['faq_category']);
  }

  $view->save();
}

/**
 * Implements hook_update_last_removed().
 */
function openculturas_faq_update_last_removed(): int {
  return 10003;
}
