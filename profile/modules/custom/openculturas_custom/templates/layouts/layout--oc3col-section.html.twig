{#
/**
 * @file
 * Default theme implementation for a three-column layout.
 *
 * Available variables:
 * - in_preview: Whether the plugin is being rendered in preview mode.
 * - content: The content for this layout.
 * - attributes: HTML attributes for the layout <div>.
 *
 * @ingroup themeable
 */
#}

{% extends '@openculturas_custom/layouts/layout--section-base.html.twig' %}

{% block section_content %}

  {% if content.first|render|trim or in_preview|default(false) %}
    {% set class = 'section section--first' %}
    <div {{ region_attributes.first.addClass(class) }}>
      {{ content.first }}
    </div>
  {% endif %}

  {% if content.second|render|trim or in_preview|default(false) %}
    {% set class = 'section section--second' %}
    <div {{ region_attributes.second.addClass(class) }}>
      {{ content.second }}
    </div>
  {% endif %}

  {% if content.third|render|trim or in_preview|default(false) %}
    {% set class = 'section section--third section--last' %}
    <div {{ region_attributes.third.addClass(class) }}>
      {{ content.third }}
    </div>
  {% endif %}

{% endblock %}
