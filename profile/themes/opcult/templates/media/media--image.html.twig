{#
/**
 * @file
 * Theme override to display a media item.
 *
 * Available variables:
 * - name: Name of the media.
 * - content: Media content.
 *
 * @see template_preprocess_media()
 *
 * @ingroup themeable
 *
 * asset is set per media bundle in the respective base template
 */
#}
{%
  set classes = [
  'media',
  'media--type-' ~ media.bundle()|clean_class,
  not media.isPublished() ? 'media--unpublished entity--unpublished',
  view_mode ? 'media--view-mode-' ~ view_mode|clean_class,
]
%}
{% set attributes = attributes.addClass(classes) %}
{% set asset = content.field_media_image %}
{% set content = content|without('field_media_image') %}
{% set wrapper_tag = 'div' %}

{% block content_wrapper %}
  <{{ wrapper_tag }} {{ attributes.addClass(classes) }}>
  {{ title_suffix.contextual_links }}
  {% if asset|render is not empty %}
    {{ asset }}
  {% endif %}
  {% if content %}
    {{ content }}
  {% endif %}
  </{{ wrapper_tag }}>
{% endblock %}
