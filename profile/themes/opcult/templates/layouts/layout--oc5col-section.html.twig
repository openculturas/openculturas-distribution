{#
/**
 * @file
 * Theme implementation for a complex 5-section layout.
 *
 * Available variables:
 * - in_preview: Whether the plugin is being rendered in preview mode.
 * - content: The content for this layout.
 * - attributes: HTML attributes for the layout <div>.
 *
 * @ingroup themeable
 */
#}

{% extends '@opcult/layouts/layout--section-base.html.twig' %}

{% block section_content %}

  {% if content.first or content.second or content.third %}
    <div id="hero-wrapper" class="wrapper--content-header">

      {% if content.first %}
        {% set class = 'section section--first section--title' %}
        <div {{ region_attributes.first.addClass(class) }}>
          {{ content.first }}
        </div>
      {% endif %}

      {% if content.second %}
        {% set class = 'section section--second section--mood' %}
        <div {{ region_attributes.second.addClass(class) }}>
          {{ content.second }}
        </div>
      {% endif %}

      {% if content.third %}
        {% set class = 'section section--third section--essentials' %}
        <div {{ region_attributes.third.addClass(class) }}>
          {{ content.third }}
        </div>
      {% endif %}

    </div>
  {% endif %}
  {% if content.fourth or content.fifth %}
    <div class="wrapper--content-main">

      {% if content.fourth %}
        {% set class = 'section section--fourth section--first section--content' %}
        <div {{ region_attributes.fourth.addClass(class) }}>
          {{ content.fourth }}
        </div>
      {% endif %}

      {% if content.fifth %}
        {% set class = 'section section--fifth section--last section--aside' %}
        <div {{ region_attributes.fifth.addClass(class) }}>
          {{ content.fifth }}
        </div>
      {% endif %}

    </div>
  {% endif %}
{% endblock %}
