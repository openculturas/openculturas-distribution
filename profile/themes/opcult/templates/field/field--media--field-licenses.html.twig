{%
  set classes = [
  'field',
  'field--name-' ~ field_name|clean_class,
  'field--type-' ~ field_type|clean_class,
  'field--label-' ~ label_display,
  label_display == 'inline' ? 'clearfix',
  'content-toggle--wrapper',
  'attribution-toggle--wrapper',
]
%}

{# data-drupal-selector below is read by opcult.js's attributionPopoverDedupeBehavior. #}
{% for item in items %}
  {% set popoverId = item.popover_id %}
  <div class="attribution-toggle" data-drupal-selector="attribution-toggle">
    <div{{ item.attributes.addClass('field__item').addClass(field_name|clean_class) }}>
      {% if not label_hidden %}
        <button id="{{ popoverId }}--trigger" popovertarget="{{ popoverId }}" {{ title_attributes.addClass('button button--attribution attribution-popover-trigger attribution-toggle--trigger attribution-toggle--popover-button')}} title="{{ label }}">{{ label }}</button>
      {% else %}
        <button id="{{ popoverId }}--trigger" popovertarget="{{ popoverId }}" {{ title_attributes.addClass('button button--attribution attribution-popover-trigger attribution-toggle--trigger attribution-toggle--popover-button')}} title="{{ 'Show attribution'|t }}">{{ 'Show attribution'|t }}</button>
      {% endif %}
      <div class="popover-content attribution-toggle--popover-content oc--attribution--layer" id="{{ popoverId }}" popover>
        {{ item.content }}
      </div>
    </div>
  </div>
{% endfor %}
