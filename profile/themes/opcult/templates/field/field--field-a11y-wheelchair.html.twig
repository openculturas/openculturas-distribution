{%
  set classes = [
  'field',
  'field--name-' ~ field_name|clean_class,
  'field--type-' ~ field_type|clean_class,
  'a11y-' ~ items[0].content['#markup']|clean_class,
]
%}
{%
  set title_classes = [
  'field__label',
  label_display == 'visually_hidden' ? 'visually-hidden',
]
%}

{% block field %}
  <div{{ attributes.addClass(classes) }}>
    {% block label %}
      {% if not label_hidden %}
        {% block label_visible %}
          <div{{ title_attributes.addClass(title_classes) }}>{{ label }}</div>
        {% endblock label_visible %}
      {% endif %}
    {% endblock label %}
    {% block items %}
      <div class="field__items">
        {% for item in items %}
          {% block item %}
            <div{{ item.attributes.addClass('field__item') }}>{{ item.content }}</div>
          {% endblock item %}
        {% endfor %}
      </div>
    {% endblock items %}
  </div>
{% endblock field %}
