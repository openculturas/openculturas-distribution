<?php

/**
 * @file
 * Install, update and uninstall functions.
 */

declare(strict_types=1);

use Drupal\Core\Entity\EntityViewModeInterface;
use Drupal\layout_builder\Entity\LayoutBuilderEntityViewDisplay;
use Drupal\node\NodeInterface;
use Drupal\openculturas_custom\EventSubscriber\OpenculturasCustomCookiesLegalPagesSubscriber;
use Drupal\user\RoleInterface;

/**
 * Implements hook_install_tasks().
 */
function openculturas_install_tasks(): array {
  return [
    'openculturas_install_role_missing_permission' => [
      'display_name' => t('Install missing permissions'),
      'type' => 'normal',
    ],
    'openculturas_install_openculturas_modules' => [
      'display_name' => t('Install OpenCulturas modules.'),
      'type' => 'normal',
    ],
    'openculturas_install_content' => [
      'display_name' => t('Install default content'),
      'type' => 'normal',
    ],
    'openculturas_install_remove_full_lb' => [
      'display_name' => t('Remove full_lb view mode'),
      'type' => 'normal',
    ],
  ];
}

/**
 * Callback function to install missing the permissions.
 *
 * This is necessary because of a circular dependency between the 'xyz' role
 * and the 'assign xyz role' permission.
 *
 * @see https://www.drupal.org/project/role_delegation/issues/3354012
 * @see openculturas_install_tasks()
 */
function openculturas_install_role_missing_permission(): void {
  /** @var \Drupal\user\RoleStorageInterface $roleStorage */
  $roleStorage = \Drupal::entityTypeManager()->getStorage('user_role');
  /** @var \Drupal\user\RoleInterface|null $role */
  $role = $roleStorage->load('oc_admin');
  if ($role instanceof RoleInterface) {
    $role->grantPermission('assign magazine_editor role');
    $role->grantPermission('assign oc_admin role');
    $role->grantPermission('assign oc_member role');
    $role->grantPermission('assign oc_organizer role');
    $role->save();
  }
}

/**
 * Callback function to install default profile content.
 *
 * @see openculturas_install_tasks()
 */
function openculturas_install_content(): void {
  $configFactory = \Drupal::configFactory();

  /** @var \Drupal\Core\Extension\ModuleInstallerInterface $module_installer */
  $module_installer = \Drupal::service('module_installer');
  // We only want to import the content,
  // then we do not need the module anymore.
  $module_installer->install(['openculturas_content']);
  // Reload the service, or we get the error:
  // In ContainerBuilder.php line 1104:
  // You have requested a synthetic service ("kernel"). The DIC does not know how to construct this service.
  /** @var \Drupal\Core\Extension\ModuleInstallerInterface $module_installer */
  $module_installer = \Drupal::service('module_installer');
  $module_installer->uninstall(['default_content', 'openculturas_content']);

  $config = $configFactory->getEditable('system.site');

  // Do not set anything when installed with existing config.
  if ($config->get('uuid') === '4e1801fb-85a2-40f3-8ad4-11f952d5e819') {
    return;
  }

  /** @var \Drupal\Core\Entity\EntityRepositoryInterface $entityRepository */
  $entityRepository = \Drupal::service('entity.repository');

  /** @var \Drupal\node\NodeInterface|null $node */
  $node = $entityRepository->loadEntityByUuid('node', 'f971a5cd-960b-40ee-b059-173c366231af');
  // File: profile/modules/custom/openculturas_content/content/node/f971a5cd-960b-40ee-b059-173c366231af.yml.
  if ($node instanceof NodeInterface) {
    $config->set('page.404', '/node/' . $node->id());
  }

  /** @var \Drupal\node\NodeInterface|null $node */
  $node = $entityRepository->loadEntityByUuid('node', '34e5758c-997b-45cd-91ed-66a694a5fdd3');
  // File: profile/modules/custom/openculturas_content/content/node/34e5758c-997b-45cd-91ed-66a694a5fdd3.yml.
  if ($node instanceof NodeInterface) {
    $config->set('page.403', '/node/' . $node->id());
  }

  /** @var \Drupal\node\NodeInterface|null $node */
  $node = $entityRepository->loadEntityByUuid('node', '9af42cc9-30a8-46a4-9432-dfcde34cd259');
  // File: profile/modules/custom/openculturas_content/content/node/9af42cc9-30a8-46a4-9432-dfcde34cd259.yml.
  if ($node instanceof NodeInterface) {
    $config->set('page.front', '/node/' . $node->id());
  }

  $config->save();

  /** @var \Drupal\node\NodeInterface|null $node */
  $node = $entityRepository->loadEntityByUuid('node', 'af738793-80dc-4b37-8790-878b4df30e5a');
  // File: profile/modules/custom/openculturas_content/content/node/af738793-80dc-4b37-8790-878b4df30e5a.yml.
  $privacyPath = $node instanceof NodeInterface ? '/node/' . $node->id() : NULL;

  /** @var \Drupal\node\NodeInterface|null $node */
  $node = $entityRepository->loadEntityByUuid('node', '64bfc6ca-f9e6-4a54-884c-ee1c763269e0');
  // File: profile/modules/custom/openculturas_content/content/node/64bfc6ca-f9e6-4a54-884c-ee1c763269e0.yml.
  $imprintPath = $node instanceof NodeInterface ? '/node/' . $node->id() : NULL;

  $legalPaths = array_filter([$privacyPath, $imprintPath]);
  if ($legalPaths !== []) {
    OpenculturasCustomCookiesLegalPagesSubscriber::addPathsToCookiesUiBlocks(\Drupal::entityTypeManager(), $legalPaths);
  }

  if (file_exists(DRUPAL_ROOT . '/profiles/contrib/openculturas-distribution/profile/themes/openculturas_base/favicons/drupal-oc-icon.png')) {
    $config = $configFactory->getEditable('gin.settings');
    $config->set('favicon.path', '/profiles/contrib/openculturas-distribution/profile/themes/openculturas_base/favicons/drupal-oc-icon.png');
    $config->save();
  }
}

/**
 * Callback function to install OpenCulturas modules.
 *
 * The modules need configurations of the OpenCulturas profile, therefore
 * we install them after the profile was installed.
 */
function openculturas_install_openculturas_modules(): void {
  /** @var \Drupal\Core\Extension\ModuleInstallerInterface $module_installer */
  $module_installer = \Drupal::service('module_installer');
  $module_installer->install(['openculturas_map']);
}

/**
 * Callback function to remove full_lb view mode.
 */
function openculturas_install_remove_full_lb(): void {
  $entityViewModeStorage = \Drupal::entityTypeManager()->getStorage('entity_view_mode');
  $entity_view_mode_ids = ['node.full_lb', 'taxonomy_term.full_lb'];
  foreach ($entityViewModeStorage->loadMultipleOverrideFree($entity_view_mode_ids) as $entity_view_mode) {
    if ($entity_view_mode instanceof EntityViewModeInterface) {
      $entity_view_mode->delete();
    }
  }
}

/**
 * Implements hook_update_last_removed().
 */
function openculturas_update_last_removed(): int {
  return 10123;
}

/**
 * Change the label of the paragraph slider view mode.
 */
function openculturas_update_10124(): void {
  $configFactory = \Drupal::configFactory();
  $config = $configFactory->getEditable('core.entity_view_mode.paragraph.slider');
  if (!$config->isNew()) {
    $config->set('label', 'Slider single');
    $config->save();
  }
}

/**
 * Remove the 'settings.jquery_library_url' key from image_widget_crop.settings.
 */
function openculturas_update_10125(): void {
  $configFactory = \Drupal::configFactory();
  $config = $configFactory->getEditable('image_widget_crop.settings');
  if (!$config->isNew()) {
    $config->clear('settings.jquery_library_url');
    $config->save();
  }
}

/**
 * Grant missing content moderation transition permissions to oc_admin role.
 */
function openculturas_update_10126(): void {
  /** @var \Drupal\user\RoleStorageInterface $roleStorage */
  $roleStorage = \Drupal::entityTypeManager()->getStorage('user_role');
  /** @var \Drupal\user\RoleInterface|null $role */
  $role = $roleStorage->load('oc_admin');
  if ($role instanceof RoleInterface) {
    $role->grantPermission('use draften transition create_new_draft');
    $role->grantPermission('use draften transition to_review');
    $role->grantPermission('use draften_member transition create_new_draft');
    $role->save();
  }
}

/**
 * Remove orphaned "Comments" layout builder blocks when openculturas_discussions is not installed.
 */
function openculturas_update_10127(): void {
  /*
   * The openculturas_discussions module is optional. If it was ever enabled and
   * then uninstalled, sites can be left with a "field_block:node:%:field_comments"
   * layout builder component that no longer resolves to a real block plugin,
   * since the field itself is removed on uninstall.
   *
   * @see \Drupal\openculturas_custom\EventSubscriber\OpenculturasCustomConfigDevelSubscriber::excludeOpenCulturasDiscussions()
   */
  if (\Drupal::moduleHandler()->moduleExists('openculturas_discussions')) {
    return;
  }

  /** @var \Drupal\Core\Entity\EntityStorageInterface $entityViewDisplayStorage */
  $entityViewDisplayStorage = \Drupal::entityTypeManager()->getStorage('entity_view_display');
  $bundles = ['event', 'location', 'profile', 'article'];
  // The 'full_lb' view mode is the opcult theme's layout builder template
  // (see theme-settings.php), copied onto 'full' when a site switches a
  // bundle to layout builder output, so it needs the same cleanup.
  $view_modes = ['full', 'full_lb'];
  foreach ($bundles as $bundle) {
    foreach ($view_modes as $view_mode) {
      /** @var \Drupal\layout_builder\Entity\LayoutBuilderEntityViewDisplay|null $display */
      $display = $entityViewDisplayStorage->load('node.' . $bundle . '.' . $view_mode);
      if (!$display instanceof LayoutBuilderEntityViewDisplay) {
        continue;
      }

      if (!$display->isLayoutBuilderEnabled()) {
        continue;
      }

      $changed = FALSE;
      foreach ($display->getSections() as $delta => $section) {
        foreach ($section->getComponents() as $uuid => $component) {
          $plugin_id = (string) ($component->get('configuration')['id'] ?? '');
          if (str_ends_with($plugin_id, ':field_comments')) {
            $section->removeComponent($uuid);
            $changed = TRUE;
          }
        }

        if (!$section->getComponents()) {
          $display->removeSection($delta);
        }
      }

      if ($changed) {
        $display->save();
      }
    }
  }
}

/**
 * Enable the cookies_popover module and update the cookies module config.
 *
 * Also installs Menu Link Attributes and grants oc_admin its "use"
 * permission, so editors can set a menu link's Link to the `<button>`
 * route and add the `editCookieSettings` class, turning it into a real
 * button that reopens the cookiesjsr settings layer. Also grants oc_admin
 * permission to configure the COOKiES widget texts, i.e. the privacy
 * policy and imprint links.
 */
function openculturas_update_10128(): void {
  /** @var \Drupal\Core\Extension\ModuleInstallerInterface $module_installer */
  $module_installer = \Drupal::service('module_installer');
  if (!\Drupal::moduleHandler()->moduleExists('cookies_popover')) {
    $module_installer->install(['cookies_popover']);
  }

  if (!\Drupal::moduleHandler()->moduleExists('menu_link_attributes')) {
    $module_installer->install(['menu_link_attributes']);
  }

  $configFactory = \Drupal::configFactory();
  $config = $configFactory->getEditable('cookies.config');
  if (!$config->isNew()) {
    $config->set('deny_all_on_layer_close', FALSE);
    $config->set('use_default_styles', FALSE);
    $config->save();
  }

  user_role_grant_permissions('oc_admin', [
    'use menu link attributes',
    'configure cookies widget texts',
    'administer cookies services and service groups',
  ]);
}

/**
 * Applies the customized cookies.texts wording to existing sites.
 *
 * Skips any value a site has already changed away from the module default.
 */
function openculturas_update_10129(): void {
  $configFactory = \Drupal::configFactory();
  $config = $configFactory->getEditable('cookies.texts');
  if ($config->isNew()) {
    return;
  }

  $replacements = [
    'bannerText' => [
      'old' => 'We use a selection of our own and third-party cookies on the pages of this website: Essential cookies, which are required in order to use the website; functional cookies, which provide better easy of use when using the website; performance cookies, which we use to generate aggregated data on website use and statistics; and marketing cookies, which are used to display relevant content and advertising. If you choose "ACCEPT ALL", you consent to the use of all cookies. You can accept and reject individual cookie types and  revoke your consent for the future at any time under "Settings".',
      'new' => 'We are avoiding third-party cookies wherever possible. For now you may opt in to watch videos. If you choose „Accept all” you consent to the use of all given cookies. You can accept and reject individual cookie types and revoke your consent for the future at any time under <em>Settings</em>.',
    ],
    'allowed' => [
      'old' => 'Allowed',
      'new' => 'allowed',
    ],
    'denied' => [
      'old' => 'Denied',
      'new' => 'denied',
    ],
    'placeholderAcceptAllText' => [
      'old' => 'Accept All Cookies',
      'new' => 'Accept all cookies',
    ],
  ];

  $changed = FALSE;
  foreach ($replacements as $key => $value) {
    if ($config->get($key) === $value['old']) {
      $config->set($key, $value['new']);
      $changed = TRUE;
    }
  }

  if ($changed) {
    $config->save();
  }
}
