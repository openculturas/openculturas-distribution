{
  "name": "openculturas",
  "description": "The OpenCulturas distribution install profile.",
  "license": "GPL-2.0-or-later",
  "private": true,
  "engines": {
    "node": ">= 22.0"
  },
  "scripts": {
    "lint:js": "eslint --ext .js .",
    "lint:css": "stylelint \"profile/modules/**/*.css\"",
    "lint:css:fix": "stylelint --fix \"profile/modules/**/*.css\"",
    "lint:scss": "stylelint --config=.stylelintrc.scss.json \"profile/themes/openculturas_base/scss_config/**/*.scss\"",
    "lint:scss:fix": "stylelint --fix --config=.stylelintrc.scss.json \"profile/themes/openculturas_base/scss_config/**/*.scss\"",
    "lint:yaml": "eslint --ext .yml .",
    "prettier": "prettier --write \"./**/*.js\"",
    "prettier:css": "prettier --write \"profile/modules/**/*.css\"",
    "prettier:scss": "prettier --write \"profile/themes/openculturas_base/scss_config/**/*.scss\""
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^9.1.0",
    "eslint-formatter-gitlab": "^5.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.5.0",
    "eslint-plugin-yml": "^1.18.0",
    "prettier": "^3.5.3",
    "stylelint": "^16.20.0",
    "stylelint-config-standard": "^36.0.1",
    "stylelint-config-standard-scss": "^14.0.0",
    "@gitlab-formatters/stylelint-formatter-gitlab": "^1.0.2",
    "stylelint-order": "^6.0.4",
    "stylelint-prettier": "^5.0.3"
  }
}
