includes:
    - phpstan-baseline.neon
parameters:
  level: 8
  checkInternalClassCaseSensitivity: true
  scanDirectories:
    - web/
  paths:
    - profile/
    - tests/
  ignoreErrors:
    - identifier: missingType.iterableValue
    - identifier: missingType.generics
    - identifier: globalDrupalDependencyInjection.useDependencyInjection
    # Kept as a helper for future tests; PHPStan analyses traits only where used.
    - identifier: trait.unused
      path: tests/src/Traits/NodeTrait.php
    # Hook classes bundle unrelated hooks, so a summed class score says little.
    - identifier: complexity.classLike
  cognitive_complexity:
    function: 15
  excludePaths:
    - '*/node_modules/*'
    - '*/ProxyClass/*'
  drupal:
    entityMapping:
      flag:
        class: Drupal\flag\Entity\Flag
        storage: Drupal\flag\Entity\Storage\FlaggingStorage
    bleedingEdge:
      checkCoreDeprecatedHooksInApiFiles: true
      checkContribDeprecatedHooksInApiFiles: true
    rules:
      testClassSuffixNameRule: true
      dependencySerializationTraitPropertyRule: true
      accessResultConditionRule: true
